{
  "name": "booknook-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "ReadWell bookstore client and API",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev --workspace @booknook/server\" \"npm run dev --workspace @booknook/client\"",
    "build": "npm run build --workspace @booknook/client",
    "start": "npm start --workspace @booknook/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm test && npm run build",
    "audit:production": "npm audit --omit=dev --workspaces",
    "seed:catalog": "node scripts/seed-open-library.mjs",
    "seed:ratings": "node scripts/backfill-ratings.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0"
  }
}
